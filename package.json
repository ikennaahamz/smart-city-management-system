{
  "name": "smart-city-management-system",
  "version": "1.0.0",
  "private": true,
  "description": "CMPE344 Smart City Management System (SCMS) - Express 5, TypeScript, PostgreSQL/PLpgSQL, Vanilla HTML/CSS/JS",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/src/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:db": "tsx scripts/run-db-tests.ts",
    "db:apply": "tsx scripts/apply-db.ts",
    "db:check": "tsx scripts/check-db.ts",
    "db:fingerprint": "tsx scripts/dsn-fingerprint.ts"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "express": "^5.1.0",
    "pg": "^8.16.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/express": "^5.0.1",
    "@types/node": "^22.15.0",
    "@types/pg": "^8.11.13",
    "@types/supertest": "^6.0.3",
    "supertest": "^7.1.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vitest": "^3.1.0"
  }
}
