# Copy this file to .env and fill in real values.
# .env is git-ignored and must never be committed.

# Pooled PostgreSQL connection used by the running web application
# (Supabase Pooler, Neon Pooler, Railway Postgres, or Render Postgres).
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# Direct (unpooled) PostgreSQL connection used by `npm run db:apply`.
# Optional on Railway/Render/local; recommended for Neon/Supabase poolers.
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@DIRECT_HOST:5432/DATABASE?sslmode=require

# Optional local PostgreSQL override when DB_TARGET=local
# DB_TARGET=local
# LOCAL_DATABASE_URL=postgresql://postgres:YOUR_LOCAL_PASSWORD@localhost:5432/smart_city_db

# Secret key for HMAC-SHA256 signed session cookies.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=replace-with-a-random-32-byte-secret

# HTTP listen port (used by src/server.ts)
PORT=3000
